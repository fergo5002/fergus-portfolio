# Committed deliberately, because every install environment has to agree.
#
# @vercel/analytics declares optional peers for every framework it supports
# (@sveltejs/kit, nuxt, vue, @remix-run/react, ...). npm tries to resolve those
# even though none of them are installed here, picks the newest @sveltejs/kit,
# and that one wants vite@8 while vitest pins vite@5 — so a plain `npm install`
# dies with ERESOLVE on a dependency this project will never use.
#
# Setting it here rather than passing --legacy-peer-deps by hand means the
# laptop, the Dockerfile.parity `npm ci` and Vercel's build all resolve the tree
# the same way. A flag that only lives in someone's shell history is exactly how
# a build passes locally and fails in production.
#
# Nothing svelte is actually installed — check package-lock.json: the only
# mentions are inside @vercel/analytics' own peer declarations.
legacy-peer-deps=true
