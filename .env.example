# Copy this file to .env.local and fill only the variables you use. Never
# commit .env.local. Server secrets must not use a NEXT_PUBLIC_ prefix.

# Write-only browser analytics token. This is intentionally public.
NEXT_PUBLIC_POSTHOG_KEY=

# Contact form delivery.
RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Optional production-only search ownership tags.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Upstash Redis. Supply either complete pair. The Vercel Marketplace
# integration normally writes KV_*; an Upstash-created database uses
# UPSTASH_*. Missing Redis keeps Overlap's manual copy-and-paste route usable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Server-only HMAC key for daily address budget pseudonyms. Required whenever
# a Redis-backed room code route is used. Generate at least 32 random bytes and
# keep the value stable: changing it resets that day's per-address counters.
# The application fails closed when it is missing and never logs its value.
BUDGET_HASH_SECRET=

# Shared store integrations used by later tools.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
